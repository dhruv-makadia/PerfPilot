<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- shutdownTimeLimit: give running k6 tests time to stop gracefully and save partial results on app pool recycle/stop. -->
      <aspNetCore processPath="dotnet" arguments=".\PerfPilot.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" shutdownTimeLimit="60" />
      <security>
        <requestFiltering>
          <!-- Allow OpenAPI uploads up to the app's 25 MB limit plus form overhead (IIS default is 30 MB). -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
