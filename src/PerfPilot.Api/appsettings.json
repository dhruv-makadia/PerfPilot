{
  "ConnectionStrings": {
    "PerfPilot": "Server=localhost;Database=PerfPilot;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "K6": {
    "BinaryPath": "k6",
    "WorkDirectory": "work",
    "MaxConcurrentRuns": 1,
    "LiveUpdateIntervalSeconds": 2,
    "GracefulStopTimeoutSeconds": 20,
    "DeleteRawOutputAfterRun": false
  },
  "Safety": {
    "MaxVus": 500,
    "MaxDurationMinutes": 120
  },
  "SpecImport": {
    "DefaultTimeoutSeconds": 30,
    "MaxTimeoutSeconds": 300,
    "MaxSpecSizeMb": 25
  },
  "ConnectionTest": {
    "TimeoutSeconds": 15
  },
  "Identity": {
    "Mode": "Header"
  },
  "DataProtection": {
    "Store": "FileSystem",
    "KeysDirectory": "keys"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/perfpilot-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
